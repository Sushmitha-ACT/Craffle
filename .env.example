# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google OAuth for the frontend and backend.
# Paste your real Google OAuth client ID values here.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# Optional: Google Maps Platform key for live map rendering.
VITE_GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_KEY"
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Secret for authentication tokens
JWT_SECRET="your_jwt_secret_key_here"

# Active Verification Provider ('truid' or 'cashfree')
VERIFICATION_PROVIDER="truid"

# TruID Verification Suite (Pending Official Developer Credentials & Portal Access)
TRUID_CLIENT_ID=""
TRUID_API_KEY=""
TRUID_ENV="sandbox"
TRUID_API_BASE_URL="https://api.truid.one"

# Cashfree Verification Suite (Preserved for seamless switching)
CASHFREE_CLIENT_ID="your_cashfree_client_id_here"
CASHFREE_CLIENT_SECRET="your_cashfree_secret_here"
CASHFREE_ENV="sandbox"

# Razorpay Payment Gateway (Test or Live)
# Get keys from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
